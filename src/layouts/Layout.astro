---
import "../styles/site.css";
import CookieBanner from "../components/CookieBanner.astro";

interface Props {
	lang: "es" | "en";
	title: string;
	description: string;
	altHref: string;
	ogImage?: string;
}

const { lang, title, description, altHref, ogImage = "/og-image.png" } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const alternateURL = new URL(altHref, Astro.site);
const esURL = lang === "es" ? canonicalURL : alternateURL;
const enURL = lang === "en" ? canonicalURL : alternateURL;
const ogImageURL = new URL(ogImage, Astro.site);
const locale = lang === "es" ? "es_ES" : "en_US";
const altLocale = lang === "es" ? "en_US" : "es_ES";

const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "/en/";

const navLinks =
	lang === "es"
		? [
				{ href: "/ia-privada", label: "IA privada" },
				{ href: "/rag-empresarial", label: "RAG empresarial" },
				{ href: "/contact", label: "Contacto" },
			]
		: [
				{ href: "/en/private-ai", label: "Private AI" },
				{ href: "/en/rag-for-business", label: "Enterprise RAG" },
				{ href: "/en/contact", label: "Contact" },
			];

const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	name: "Zaviren",
	url: "https://zaviren.com",
	logo: new URL("/favicon.svg", Astro.site).toString(),
	description,
};

const softwareApplicationSchema = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "Zaviren",
	applicationCategory: "BusinessApplication",
	operatingSystem: "Web",
	url: "https://zaviren.com",
	description,
};
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>

		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" hreflang="es" href={esURL} />
		<link rel="alternate" hreflang="en" href={enURL} />
		<link rel="alternate" hreflang="x-default" href={esURL} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:locale" content={locale} />
		<meta property="og:locale:alternate" content={altLocale} />
		<meta property="og:site_name" content="Zaviren" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		{isHome && <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />}
		{isHome && <script type="application/ld+json" set:html={JSON.stringify(softwareApplicationSchema)} />}

		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			window.gtag = gtag;
			gtag("js", new Date());
		</script>
		<script>
			document.addEventListener("click", (event) => {
				const cta = (event.target as HTMLElement).closest("a.cta");
				if (!cta) return;
				gtag("event", "cta_click", {
					link_url: (cta as HTMLAnchorElement).getAttribute("href"),
					link_text: cta.textContent?.trim(),
					page_path: window.location.pathname,
				});
			});
		</script>
	</head>
	<body>
		<div class="wrap">
			<header class="topbar">
				<a class="logo" href={lang === "es" ? "/" : "/en/"}>
					<img class="logo-mark" src="/favicon.svg" alt="Zaviren" width="26" height="20" />
					<span class="logo-word">ZAVIREN</span>
				</a>
				<nav class="site-nav">
					{navLinks.map((link) => (
						<a href={link.href} class:list={{ active: Astro.url.pathname === link.href }}>
							{link.label}
						</a>
					))}
				</nav>
				<a class="lang-link" href={altHref}>
					{lang === "es" ? <><span class="flag">🇬🇧</span> EN</> : <><span class="flag">🇪🇸</span> ES</>}
				</a>
			</header>

			<main>
				<slot />
			</main>
		</div>

		<footer class="site-footer">
			<span>© 2026 Zaviren · <a href="https://zaviren.com">zaviren.com</a> · <a href="mailto:contact@zaviren.com">contact@zaviren.com</a></span>
			<span>{lang === "es" ? "Tus datos no se comparten con terceros" : "Your data is never shared with third parties"}</span>
			<span class="footer-legal">
				{
					lang === "es" ? (
						<>
							<a href="/aviso-legal">Aviso legal</a> · <a href="/privacidad">Privacidad</a> ·{" "}
							<a href="/cookies">Cookies</a>
						</>
					) : (
						<>
							<a href="/en/legal-notice">Legal notice</a> · <a href="/en/privacy">Privacy</a> ·{" "}
							<a href="/en/cookies">Cookies</a>
						</>
					)
				}
			</span>
		</footer>

		<CookieBanner lang={lang} />
	</body>
</html>
