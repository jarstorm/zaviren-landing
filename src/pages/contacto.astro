---
import Layout from "../layouts/Layout.astro";
---

<Layout
	lang="es"
	title="Contacto — Zaviren"
	description="Déjanos tus datos y te avisamos en cuanto Zaviren esté listo."
	altHref="/en/contact"
>
	<section class="contact">
		<span class="eyebrow">Contacto</span>
		<h1>Avísame cuando esté listo</h1>
		<p class="subtitle">
			Déjanos el nombre de tu empresa, tu nombre y tu email. Te escribimos en
			cuanto Zaviren esté disponible.
		</p>
		<form class="contact-form" action="https://formsubmit.co/contact@zaviren.com" method="POST">
			<input type="hidden" name="_subject" value="Nuevo contacto — Zaviren" />
			<input type="hidden" name="_next" value="https://www.zaviren.com/contacto/gracias" />
			<input type="hidden" name="_captcha" value="false" />
			<input type="text" name="_honey" class="honey" tabindex="-1" autocomplete="off" />

			<div class="field">
				<label for="empresa">Empresa</label>
				<input type="text" id="empresa" name="Empresa" required />
			</div>
			<div class="field">
				<label for="nombre">Nombre</label>
				<input type="text" id="nombre" name="Nombre" required />
			</div>
			<div class="field">
				<label for="email">Email</label>
				<input type="email" id="email" name="Email" required />
			</div>

			<button type="submit" class="cta">Enviar</button>
		</form>
		<a class="back-link" href="/">&larr; Volver a la portada</a>
	</section>
</Layout>
