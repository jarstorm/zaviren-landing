	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: [
		{ "@type": "Question", name: "¿Qué formatos de documento soporta?", acceptedAnswer: { "@type": "Answer", text: "PDF, Word, Excel, PowerPoint y varios más, incluidas tablas y contenido escaneado vía OCR cuando hace falta." } },
		{ "@type": "Question", name: "¿Hace falta reorganizar nuestras carpetas antes de empezar?", acceptedAnswer: { "@type": "Answer", text: "No. Se conecta a la estructura de carpetas, intranet o gestor documental que ya usas tal cual está hoy." } },
		{ "@type": "Question", name: "¿Cuánto tarda en indexar nuestros documentos?", acceptedAnswer: { "@type": "Answer", text: "Depende del volumen, pero un corpus de varios miles de documentos suele estar listo en horas, no días." } },
		{ "@type": "Question", name: "¿Puede equivocarse o inventar una respuesta?", acceptedAnswer: { "@type": "Answer", text: "El sistema está diseñado para responder solo con lo que encuentra en tus documentos; si no encuentra una fuente suficientemente buena, lo dice en vez de inventar una respuesta." } },
		{ "@type": "Question", name: "¿Es lo mismo que la IA privada de Zaviren?", acceptedAnswer: { "@type": "Answer", text: "RAG es la técnica que hace posible responder con tus documentos; la IA privada es que todo eso corre dentro de tu propia infraestructura, sin salir a la nube de un tercero. Van juntas." } },
	],
})} />
