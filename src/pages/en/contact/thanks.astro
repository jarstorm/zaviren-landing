---
import Layout from "../../../layouts/Layout.astro";
import BackLink from "../../../components/BackLink.astro";
---

<Layout
	lang="en"
	title="Thanks | Zaviren"
	description="We've received your details. We'll notify you as soon as Zaviren is ready."
	altHref="/contact/gracias"
>
	<section class="thanks">
		<span class="eyebrow">Received</span>
		<h1>Thanks, we've got it</h1>
		<p>We'll reach out as soon as Zaviren is available for your company.</p>
		<BackLink lang="en" />
	</section>
</Layout>

<script>
	window.dataLayer = window.dataLayer || [];
	window.dataLayer.push(["event", "generate_lead", { lead_type: "contact", language: "en" }]);
</script>
