---
import Layout from "../../layouts/Layout.astro";
---

<Layout
	lang="en"
	title="Free guide — Does your company need AI? — Zaviren"
	description="Download Zaviren's free guide: how to know if your company needs AI and where to start."
	altHref="/guide"
>
	<section class="contact">
		<span class="eyebrow">Free guide</span>
		<h1>Does your company need AI?</h1>
		<p class="subtitle">
			Download our introductory guide: how to know if your company needs AI
			and how to get started. Leave us your details and we'll email you the
			download link.
		</p>
		<div class="guide-toc">
			<span class="guide-toc-label">What's inside</span>
			<ul>
				<li>The state of AI today</li>
				<li>The cost of not acting</li>
				<li>The risks of the cloud</li>
				<li>The alternatives</li>
				<li>How to protect and implement it</li>
			</ul>
		</div>
		<div class="form-card">
			<form class="contact-form" id="guide-form">
				<div class="field">
					<label for="nombre">First name<span class="required">*</span></label>
					<input type="text" id="nombre" name="nombre" placeholder="First name" required />
				</div>
				<div class="field">
					<label for="apellidos">Last name<span class="required">*</span></label>
					<input type="text" id="apellidos" name="apellidos" placeholder="Last name" required />
				</div>
				<div class="field">
					<label for="empresa">Company name<span class="required">*</span></label>
					<input type="text" id="empresa" name="empresa" placeholder="Company" required />
				</div>
				<div class="field">
					<label for="email">Email<span class="required">*</span></label>
					<input type="email" id="email" name="email" placeholder="example@example.com" required />
				</div>

				<label class="consent">
					<input type="checkbox" name="consent" required />
					<span>I agree to receive your communications and accept the data privacy policy.</span>
				</label>

				<p class="form-error" id="form-error" hidden></p>

				<button type="submit" class="cta" id="submit-btn">Download guide</button>
			</form>
		</div>
		<a class="back-link" href="/en/">&larr; Back to home</a>
	</section>
</Layout>

<script>
	const WORKER_URL = "https://zaviren-contact.zaviren.workers.dev";

	const form = document.getElementById("guide-form") as HTMLFormElement;
	const errorEl = document.getElementById("form-error") as HTMLParagraphElement;
	const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

	form.addEventListener("submit", async (event) => {
		event.preventDefault();
		errorEl.hidden = true;
		submitBtn.disabled = true;
		submitBtn.textContent = "Sending...";

		const data = new FormData(form);
		const payload = {
			nombre: data.get("nombre"),
			apellidos: data.get("apellidos"),
			empresa: data.get("empresa"),
			email: data.get("email"),
			locale: "EN",
			wantsGuide: true,
			consent: data.get("consent") === "on",
		};

		try {
			const res = await fetch(`${WORKER_URL}/contact`, {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify(payload),
			});
			const result = await res.json();
			if (res.ok && result.ok) {
				window.gtag?.("event", "generate_lead", { method: "guide_form", locale: "EN" });
				window.location.href = "/en/guide/thanks";
				return;
			}
			throw new Error(result.error ?? "unknown_error");
		} catch {
			errorEl.textContent = "We couldn't send the form. Please try again in a few minutes.";
			errorEl.hidden = false;
			submitBtn.disabled = false;
			submitBtn.textContent = "Download guide";
		}
	});
</script>
