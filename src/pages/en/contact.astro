---
import Layout from "../../layouts/Layout.astro";
---

<Layout
	lang="en"
	title="Contact — Zaviren"
	description="Leave your details and we'll notify you as soon as Zaviren is ready."
	altHref="/contacto"
>
	<section class="contact">
		<span class="eyebrow">Contact</span>
		<h1>Let me know when it's ready</h1>
		<p class="subtitle">
			Leave us your company name, your name and your email. We'll write to
			you as soon as Zaviren is available.
		</p>
		<div class="form-card">
			<form class="contact-form" id="contact-form">
				<input type="text" name="honeypot" class="honey" tabindex="-1" autocomplete="off" />

				<div class="field">
					<label for="nombre">First name<span class="required">*</span></label>
					<input type="text" id="nombre" name="nombre" placeholder="First name" required />
				</div>
				<div class="field">
					<label for="apellidos">Last name<span class="required">*</span></label>
					<input type="text" id="apellidos" name="apellidos" placeholder="Last name" required />
				</div>
				<div class="field">
					<label for="empresa">Company name<span class="required">*</span></label>
					<input type="text" id="empresa" name="empresa" placeholder="Company" required />
				</div>
				<div class="field">
					<label for="email">Email<span class="required">*</span></label>
					<input type="email" id="email" name="email" placeholder="example@example.com" required />
				</div>

				<label class="consent">
					<input type="checkbox" name="consent" required />
					<span>I agree to receive your communications and accept the data privacy policy.</span>
				</label>

				<p class="form-error" id="form-error" hidden></p>

				<button type="submit" class="cta" id="submit-btn">Send</button>
			</form>
		</div>
		<a class="back-link" href="/en/">&larr; Back to home</a>
	</section>
</Layout>

<script>
	const WORKER_URL = "https://zaviren-contact.zaviren.workers.dev";

	const form = document.getElementById("contact-form") as HTMLFormElement;
	const errorEl = document.getElementById("form-error") as HTMLParagraphElement;
	const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

	form.addEventListener("submit", async (event) => {
		event.preventDefault();
		errorEl.hidden = true;
		submitBtn.disabled = true;
		submitBtn.textContent = "Sending...";

		const data = new FormData(form);
		const payload = {
			nombre: data.get("nombre"),
			apellidos: data.get("apellidos"),
			empresa: data.get("empresa"),
			email: data.get("email"),
			locale: "EN",
			consent: data.get("consent") === "on",
			honeypot: data.get("honeypot"),
		};

		try {
			const res = await fetch(`${WORKER_URL}/contact`, {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify(payload),
			});
			const result = await res.json();
			if (res.ok && result.ok) {
				window.location.href = "/en/contact/thanks";
				return;
			}
			throw new Error(result.error ?? "unknown_error");
		} catch {
			errorEl.textContent = "We couldn't send the form. Please try again in a few minutes.";
			errorEl.hidden = false;
			submitBtn.disabled = false;
			submitBtn.textContent = "Send";
		}
	});
</script>
