---
import Layout from "../../layouts/Layout.astro";
---

<Layout
	lang="en"
	title="Contact — Zaviren"
	description="Leave your details and we'll notify you as soon as Zaviren is ready."
	altHref="/contacto"
>
	<section class="contact">
		<span class="eyebrow">Contact</span>
		<h1>Notify me when it's ready</h1>
		<p class="subtitle">
			Leave your company name, your name and your email. We'll reach out as
			soon as Zaviren is available.
		</p>
		<form class="contact-form" action="https://formsubmit.co/contact@zaviren.com" method="POST">
			<input type="hidden" name="_subject" value="New contact — Zaviren" />
			<input type="hidden" name="_next" value="https://www.zaviren.com/en/contact/thanks" />
			<input type="hidden" name="_captcha" value="false" />
			<input type="text" name="_honey" class="honey" tabindex="-1" autocomplete="off" />

			<div class="field">
				<label for="company">Company</label>
				<input type="text" id="company" name="Company" required />
			</div>
			<div class="field">
				<label for="name">Name</label>
				<input type="text" id="name" name="Name" required />
			</div>
			<div class="field">
				<label for="email">Email</label>
				<input type="email" id="email" name="Email" required />
			</div>

			<button type="submit" class="cta">Send</button>
		</form>
		<a class="back-link" href="/en/">&larr; Back to home</a>
	</section>
</Layout>
