---
import Layout from "../../../layouts/Layout.astro";
import BackLink from "../../../components/BackLink.astro";
import { postsEn } from "../../../data/posts";
---

<Layout
	lang="en"
	title="Blog on private AI for business — Zaviren"
	description="Articles on private AI, enterprise RAG and how to use artificial intelligence in your company without sending data to a third party's cloud."
	altHref="/blog"
>
	<section class="hero">
		<span class="eyebrow">Blog</span>
		<h1>Private AI, <span class="gradient">explained without hype</span></h1>
		<p class="subtitle">
			Articles on using AI in your company without your documents leaving
			your network — the upsides and the downsides.
		</p>
	</section>

	<section class="block">
		<div class="post-list">
			{postsEn.map((post) => (
				<a class="post-card" href={post.href}>
					<div class="post-card-meta">
						<span class="post-tag">{post.tag}</span>
						<span>{post.dateLabel}</span>
						<span>·</span>
						<span>{post.readingTime}</span>
					</div>
					<h2>{post.title}</h2>
					<p>{post.excerpt}</p>
					<span class="post-more">Read the article →</span>
				</a>
			))}
		</div>
	</section>

	<section class="block">
		<div class="final-cta">
			<div>
				<h2>Let's look at your data</h2>
				<p>A 30-minute call to see which use case makes sense to start with in your company.</p>
			</div>
			<a class="cta" href="/en/contact">Book a call</a>
		</div>
	</section>

	<div style="margin-bottom: 3rem">
		<BackLink lang="en" />
	</div>
</Layout>

<style>
	.post-list {
		max-width: 820px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
	}
	.post-card {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		border: 1px solid var(--border);
		background: var(--card);
		border-radius: 18px;
		padding: 1.8rem 2rem;
		text-decoration: none;
		color: inherit;
	}
	.post-card:hover {
		border-color: var(--blue);
	}
	.post-card-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		font-size: 0.78rem;
		color: var(--muted);
	}
	.post-tag {
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--blue);
		border: 1px solid #3b82f640;
		background: #3b82f61f;
		border-radius: 999px;
		padding: 0.2rem 0.6rem;
		font-size: 0.68rem;
	}
	.post-card h2 {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 800;
		line-height: 1.3;
	}
	.post-card p {
		margin: 0;
		font-size: 0.92rem;
		line-height: 1.6;
		color: var(--muted);
	}
	.post-more {
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--blue);
	}
</style>
