---
import Layout from "../layouts/Layout.astro";
import BackLink from "../components/BackLink.astro";
---

<Layout
	lang="es"
	title="Guía gratuita — ¿Tu empresa necesita IA? — Zaviren"
	description="Descarga la guía gratuita de Zaviren: cómo saber si tu empresa necesita IA y por dónde empezar."
	altHref="/en/guide"
>
	<section class="contact">
		<span class="eyebrow">Guía gratuita</span>
		<h1>¿Tu empresa necesita IA?</h1>
		<p class="subtitle">
			Descarga nuestra guía introductoria: cómo saber si tu empresa necesita
			IA y cómo empezar. Déjanos tus datos y te mandamos el enlace de
			descarga por email.
		</p>
		<div class="guide-toc">
			<span class="guide-toc-label">Lo que verás dentro</span>
			<ul>
				<li>El estado de la IA</li>
				<li>El coste de no actuar</li>
				<li>Los riesgos de la nube</li>
				<li>Las alternativas</li>
				<li>Cómo protegerte e implementarla</li>
			</ul>
		</div>
		<div class="form-card">
			<form class="contact-form" id="guide-form">
				<div class="field">
					<label for="nombre">Introduce tu Nombre<span class="required">*</span></label>
					<input type="text" id="nombre" name="nombre" placeholder="Nombre" required />
				</div>
				<div class="field">
					<label for="apellidos">Introduce tus Apellidos<span class="required">*</span></label>
					<input type="text" id="apellidos" name="apellidos" placeholder="Apellidos" required />
				</div>
				<div class="field">
					<label for="empresa">Nombre de la empresa<span class="required">*</span></label>
					<input type="text" id="empresa" name="empresa" placeholder="Empresa" required />
				</div>
				<div class="field">
					<label for="email">Introduce tu email<span class="required">*</span></label>
					<input type="email" id="email" name="email" placeholder="example@example.com" required />
				</div>

				<label class="consent">
					<input type="checkbox" name="consent" required />
					<span>Acepto recibir vuestras comunicaciones y la política de privacidad de datos.</span>
				</label>

				<p class="form-error" id="form-error" hidden></p>

				<button type="submit" class="cta" id="submit-btn">Descargar guía</button>
			</form>
		</div>
		<BackLink lang="es" />
	</section>
</Layout>

<script>
	const WORKER_URL = "https://zaviren-contact.zaviren.workers.dev";

	const form = document.getElementById("guide-form") as HTMLFormElement;
	const errorEl = document.getElementById("form-error") as HTMLParagraphElement;
	const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

	form.addEventListener("submit", async (event) => {
		event.preventDefault();
		errorEl.hidden = true;
		submitBtn.disabled = true;
		submitBtn.textContent = "Enviando...";

		const data = new FormData(form);
		const payload = {
			nombre: data.get("nombre"),
			apellidos: data.get("apellidos"),
			empresa: data.get("empresa"),
			email: data.get("email"),
			locale: "ES",
			wantsGuide: true,
			consent: data.get("consent") === "on",
		};

		try {
			const res = await fetch(`${WORKER_URL}/contact`, {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify(payload),
			});
			const result = await res.json();
			if (res.ok && result.ok) {
				window.gtag?.("event", "generate_lead", { method: "guide_form", locale: "ES" });
				window.location.href = "/guide/gracias";
				return;
			}
			throw new Error(result.error ?? "unknown_error");
		} catch {
			errorEl.textContent = "No hemos podido enviar el formulario. Inténtalo de nuevo en unos minutos.";
			errorEl.hidden = false;
			submitBtn.disabled = false;
			submitBtn.textContent = "Descargar guía";
		}
	});
</script>
